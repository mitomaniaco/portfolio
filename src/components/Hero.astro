---
import { getImage, Image } from 'astro:assets';
import { pic } from '../lib/img';
import portrait from '../assets/img/caio-portrait.jpg';
import logoRaw from '../assets/img/logo-raccoon.svg?raw';
const logoSvg = logoRaw.replace(/<title>.*?<\/title>/s, '').replace('<svg ', '<svg class="mark" aria-hidden="true" focusable="false" ').replace('fill="#000"', 'fill="currentColor"');
import br from '../assets/flags/br.svg';
import us from '../assets/flags/us.svg';
import { ui, cvFile, home, type Lang } from '../i18n/ui';

const { lang = 'pt' } = Astro.props as { lang?: Lang };
const t = ui[lang].hero; const N = ui[lang].nav; const cv = cvFile[lang];
const flagSrc: Record<string, string> = { pt: br.src, en: us.src };

const tile = async (file: string) => (await getImage({ src: pic(file), width: 360, format: 'webp', quality: 62 })).src;
const prev = async (file: string) => (await getImage({ src: pic(file), width: 720, format: 'webp', quality: 72 })).src;

// mural: cada coluna desce em velocidade própria; a lista é duplicada para o laço ser contínuo
const cols = await Promise.all([
  ['maxima-tecnologias-semana-2-protecao-de-ativos-post.webp', 'clientes-result-dezembro-semana-1-4-quinta-finalizado-quinta-01.webp', 'clientes-instruir-treinamentos-finalizado-post.webp', 'clientes-colegio-palavras-do-amor-finalizado-postalterado.webp'],
  ['site-vizu-m.webp', 'clientes-monitor-engenharia-finalizado-onibus-inspecao.webp', 'hub-inbox-story.webp', 'clientes-bsa-bones-bone-finalizado-post.webp'],
  ['clientes-militares-finalizado-sem-titulo-1-01.webp', 'nobre-carrossel-1.webp', 'site-nobre-m.webp', 'maxima-tecnologias-semana-2-protecao-de-ativos-post.webp'],
  ['site-rdf-m.webp', 'clientes-colegio-palavras-do-amor-finalizado-postalterado.webp', 'clientes-result-dezembro-semana-1-4-quinta-finalizado-quinta-01.webp', 'clientes-instruir-treinamentos-finalizado-post.webp'],
  ['nobre-carrossel-1.webp', 'clientes-bsa-bones-bone-finalizado-post.webp', 'site-vizu-m.webp', 'clientes-monitor-engenharia-finalizado-onibus-inspecao.webp'],
].map((c) => Promise.all(c.map(tile))));
const speeds = [90, 120, 100, 135, 110];

const words = [
  { href: '#social', u: '#f2b73c', img: await prev('maxima-tecnologias-semana-2-protecao-de-ativos-post.webp') },
  { href: '', u: '#ff7a52', img: '' },
  { href: '#sites', u: '#5aa9f5', img: await prev('site-vizu-hero.webp'), land: true },
  { href: '#sistema', u: '#3ddc84', img: await prev('hub-crm.webp'), land: true },
];
const roleLine = `${t.r[0]}, ${t.r[1]} ${t.and} ${t.r[2]}`;
---
<header class="nav" data-nav>
  <div class="wrap nav-in">
    <a class="me glass" href="#top" ><Fragment set:html={logoSvg} /><span>Caio Augusto</span></a>
    <nav class="glass" aria-label={N.label} data-links>
      <a href="#social">{N.social}</a>
      <a href="#sites">{N.sites}</a>
      <a href="#sistema">{N.hub}</a>
      <a href="#sobre">{N.about}</a>
      <a href="#contato">{N.contact}</a>
    </nav>
    <div class="right">
      <div class="lang glass" role="group" aria-label={N.switchTo}>
        {(['pt', 'en'] as Lang[]).map((l) => l === lang
          ? <span class="fl on" aria-current="true" lang={l} title={l === 'pt' ? 'Português' : 'English'}><img src={flagSrc[l]} alt="" width="24" height="24" /></span>
          : <a class="fl" href={home[l]} hreflang={l} lang={l} data-lang-toggle={l} aria-label={N.switchTo} title={N.switchTo}><img src={flagSrc[l]} alt="" width="24" height="24" /></a>)}
      </div>
      <a class="pill cv glass" href={cv} download>{N.cv}</a>
      <button class="burger glass" type="button" aria-expanded="false" aria-controls="menu" aria-label={N.open} data-burger data-open={N.open} data-close={N.close}><i></i><i></i></button>
    </div>
    <div class="menu glass" id="menu" data-menu hidden>
      <a href="#social">{N.social}</a>
      <a href="#sites">{N.sites}</a>
      <a href="#sistema">{N.hub}</a>
      <a href="#sobre">{N.about}</a>
      <a href="#contato">{N.contact}</a>
      <a class="mcv" href={cv} download>{N.cvFull}</a>
    </div>
  </div>
</header>

<section class="hero" id="top" aria-labelledby="name" data-hero>
  <div class="mural" aria-hidden="true">
    {cols.map((c, i) => (
      <div class="col" style={`--d:${speeds[i]}s`}>
        <div class="trk">
          {[0, 1].map(() => <div class="set">{c.map((s) => <img src={s} alt="" width="360" height="450" loading="lazy" decoding="async" />)}</div>)}
        </div>
      </div>
    ))}
  </div>
  <div class="shade"></div>

  <div class="wrap stage">
    <h1 class="stmt" id="name">
      {t.pre}{' '}
      {t.w.map((w, i) => (
        <>
          <span class="nb">{words[i].href ? <a class="wd" href={words[i].href} data-w={i} style={`--u:${words[i].u}`}>{w}</a> : <span class="wd st" style={`--u:${words[i].u}`}>{w}</span>}{i < t.w.length - 2 ? ',' : i === t.w.length - 1 ? '.' : ''}</span>{i === t.w.length - 2 ? ` ${t.and} ` : i < t.w.length - 2 ? ' ' : ''}
        </>
      ))}
    </h1>

    <div class="pvw"><div class="pv" aria-hidden="true">
      {words.map((w, i) => w.href && <figure data-pv={i} class={'land' in w ? 'land' : ''}><img src={w.img} alt="" width="720" height="450" loading="lazy" decoding="async" /><figcaption>{t.pvLabel[i]}</figcaption></figure>)}
    </div></div>

    <div class="by">
      <Image class="by-av" src={portrait} alt="Caio Augusto" width={132} height={165} format="webp" quality={84} loading="eager" />
      <div class="by-t">
        <b>Caio Augusto</b>
        <span>{roleLine}</span>
        <small class="avail"><i aria-hidden="true"></i>{t.avail}</small>
      </div>
      <p class="hint">{t.hint}</p>
    </div>
  </div>
</section>

<style>
  .nav { position: sticky; top: 0; z-index: 40; padding-block: 10px; margin-bottom: -66px; color: var(--ink); transition: color 300ms ease; --g: rgb(247 246 243 / 0.78); --gb: rgb(17 17 16 / 0.1); }
  .nav::before { content: ''; position: absolute; inset: 0; z-index: -1; background: rgb(247 246 243 / 0.9); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); box-shadow: 0 1px 0 rgb(17 17 16 / 0.08); opacity: 0; transition: opacity 240ms ease, background-color 300ms ease; pointer-events: none; }
  .nav.stuck::before { opacity: 1; }
  .nav-in { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .glass { background: var(--g); box-shadow: inset 0 0 0 1px var(--gb), 0 6px 20px -12px rgb(0 0 0 / 0.35); -webkit-backdrop-filter: blur(14px) saturate(1.4); backdrop-filter: blur(14px) saturate(1.4); transition: background-color 400ms var(--ease), box-shadow 300ms ease; }
  .me { display: inline-flex; align-items: center; gap: 10px; min-height: 46px; padding: 3px 18px 3px 16px; border-radius: 999px; font-weight: 700; font-size: 0.9375rem; }
  .me :global(.mark) { flex: none; display: block; height: 28px; width: auto; aspect-ratio: 284.76 / 208.38; }
  nav { display: flex; gap: 4px; padding: 4px; border-radius: 999px; font-size: var(--t-s); }
  nav a { display: inline-flex; align-items: center; justify-content: center; min-height: 38px; padding: 0 16px; border-radius: 999px; opacity: 0.78; transition: opacity 140ms ease, background-color 200ms ease; }
  /* larguras fixas (a maior entre PT e EN) para a barra não mudar de tamanho ao trocar o idioma */
  nav a:nth-child(1) { min-width: 119px; }
  nav a:nth-child(2) { min-width: 95px; }
  nav a:nth-child(3) { min-width: 88px; }
  nav a:nth-child(4) { min-width: 73px; }
  nav a:nth-child(5) { min-width: 87px; }
  nav a[aria-current='true'] { opacity: 1; background: rgb(127 127 127 / 0.16); }
  @media (hover: hover) { nav a:hover { opacity: 1; } }
  .cv { min-height: 46px; min-width: 108px; justify-content: center; padding: 0 20px; }
  .lang { display: inline-flex; align-items: center; gap: 2px; min-height: 46px; padding: 4px; border-radius: 999px; }
  .fl { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%; opacity: 0.6; transition: opacity 160ms ease, background-color 200ms ease, transform 160ms var(--ease); }
  .fl img { width: 24px; height: 24px; display: block; border-radius: 50%; object-fit: cover; box-shadow: 0 0 0 1px rgb(0 0 0 / 0.12); }
  .fl.on { opacity: 1; background: rgb(127 127 127 / 0.2); }
  a.fl:active { transform: scale(0.92); }
  @media (hover: hover) { a.fl:hover { opacity: 1; } }
  .right { display: flex; align-items: center; gap: 8px; }
  .burger, .menu { display: none; }
  @media (max-width: 860px) {
    nav, .cv { display: none; }
    .burger { display: grid; place-content: center; gap: 6px; width: 46px; height: 46px; border-radius: 16px; }
    .burger i { display: block; width: 18px; height: 2px; border-radius: 2px; background: currentColor; transition: transform 240ms var(--ease); }
    .burger[aria-expanded='true'] i:first-child { transform: translateY(4px) rotate(45deg); }
    .burger[aria-expanded='true'] i:last-child { transform: translateY(-4px) rotate(-45deg); }
    .menu { position: absolute; left: 0; right: 0; top: calc(100% + 8px); flex-direction: column; padding: 8px; border-radius: 22px; background: var(--paper); color: var(--ink); }
    .menu:not([hidden]) { display: flex; animation: drop 220ms var(--ease); }
    .menu a { display: flex; align-items: center; min-height: 48px; padding: 0 14px; border-radius: 14px; font-weight: 600; }
    .menu a:active { background: var(--paper-2); }
    .menu .mcv { margin-top: 4px; background: var(--ink); color: #fff; justify-content: center; }
    @keyframes drop { from { opacity: 0; transform: translateY(-6px) scale(0.98); } }
  }

  /* ===== hero manifesto sobre o mural ===== */
  .hero { position: relative; isolation: isolate; overflow: hidden; background: #fff; color: var(--ink); min-height: min(100svh, 940px); display: flex; }
  .mural { position: absolute; inset: 0; z-index: -2; display: flex; gap: 16px; padding-inline: 16px; opacity: 0.55; filter: saturate(0.9); }
  .col { flex: 1; min-width: 0; overflow: hidden; }
  .trk { display: flex; flex-direction: column; animation: down var(--d) linear infinite; will-change: transform; }
  .set { display: flex; flex-direction: column; gap: 16px; padding-bottom: 16px; }
  .set img { width: 100%; height: auto; border-radius: 20px; }
  @keyframes down { from { transform: translateY(-50%); } to { transform: translateY(0); } }
  .shade { position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgb(255 255 255 / 0.97), rgb(255 255 255 / 0.86) 55%, rgb(255 255 255 / 0.3)), linear-gradient(0deg, rgb(255 255 255 / 0.95), transparent 34%), linear-gradient(180deg, rgb(255 255 255 / 0.9), transparent 18%); pointer-events: none; }

  .stage { color: var(--ink); background: none; border-radius: 0; position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, min(400px, 30vw)); grid-template-rows: 1fr auto; column-gap: clamp(32px, 4vw, 72px); row-gap: 40px; align-items: center; padding-block: calc(66px + clamp(40px, 7vh, 90px)) clamp(28px, 4vh, 44px); }
  .stmt { grid-column: 1; grid-row: 1; font-size: clamp(2.5rem, 0.4rem + 5.6vw, 7rem); font-weight: 600; letter-spacing: -0.05em; line-height: 1; text-wrap: balance; }
  .nb { white-space: nowrap; }
  .wd { position: relative; display: inline-block; z-index: 0; padding-inline: 0.04em; border-radius: 0.14em; transition: color 160ms ease; }
  .wd::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0.06em; height: 0.09em; background: var(--u); border-radius: 2px; z-index: -1; transition: height 220ms var(--ease), bottom 220ms var(--ease), left 220ms var(--ease), right 220ms var(--ease), border-radius 220ms var(--ease); }
  .wd.st { cursor: default; }
  .wd:focus-visible { outline: none; }
  .wd:not(.st):hover, .wd:focus-visible, .wd.on { color: #13213b; }
  .wd:not(.st):hover::after, .wd:focus-visible::after, .wd.on::after { height: 100%; bottom: 0; left: -0.06em; right: -0.06em; border-radius: 0.14em; }

  .pvw { --edge: max(var(--gut), calc((100vw - var(--max)) / 2)); margin-right: calc(-1 * max(0px, min(160px, calc(var(--edge) - 16px)))); grid-column: 2; grid-row: 1; position: relative; align-self: stretch; min-height: 320px; pointer-events: none; }
  .pv { position: absolute; inset: 0; }
  .pv figure { position: absolute; left: 0; right: 0; top: 50%; width: fit-content; max-width: 100%; margin: 0 auto; border-radius: 20px; overflow: hidden; background: #fff; transform: translateY(calc(-50% + 14px)) rotate(2deg) scale(0.96); opacity: 0; transition: opacity 200ms ease, transform 320ms var(--ease); box-shadow: 0 36px 64px -28px rgb(17 17 16 / 0.5), 0 0 0 1px rgb(17 17 16 / 0.1); }
  .pv figure.on { opacity: 1; transform: translateY(-50%) rotate(2deg); }
  .pv figure.land { width: 100%; max-height: min(70svh, 560px); aspect-ratio: 5 / 4; }
  .pv figure.land img { width: 100%; height: 100%; max-height: none; object-fit: cover; object-position: top left; }
  .pv img { display: block; width: auto; max-width: 100%; height: auto; max-height: min(62svh, 560px); }
  .pv figcaption { position: absolute; left: 14px; bottom: 14px; font-size: 0.875rem; font-weight: 700; padding: 7px 12px; border-radius: 999px; background: #fff; color: #13213b; box-shadow: 0 2px 10px rgb(0 0 0 / 0.18); }

  .by { grid-column: 1 / -1; grid-row: 2; position: relative; z-index: 4; display: flex; align-items: center; gap: 16px; }
  .by-av { width: 56px; height: 70px; border-radius: 18px; object-fit: cover; object-position: top; box-shadow: 0 0 0 2px rgb(17 17 16 / 0.12); background: #d9d9d9; }
  .by-t { display: grid; gap: 2px; }
  .by-t b { font-size: 1.125rem; font-weight: 600; letter-spacing: -0.01em; }
  .by-t span { font-size: var(--t-s); opacity: 0.82; }
  .avail { display: inline-flex; align-items: center; gap: 8px; margin-top: 4px; font-size: var(--t-xs); font-weight: 600; opacity: 0.9; }
  .avail i { width: 8px; height: 8px; border-radius: 50%; background: var(--live); box-shadow: 0 0 0 4px rgb(93 242 155 / 0.2); }
  .hint { margin-left: auto; display: flex; align-items: center; gap: 10px; font-size: var(--t-xs); opacity: 0.7; }
  .hint::before { content: ''; width: 36px; height: 1px; background: currentColor; }

  @media (hover: none) { .hint, .pvw { display: none; } }
  @media (max-width: 960px) {
    .stage { grid-template-columns: minmax(0, 1fr); }
    .pvw, .hint { display: none; }
    .col:nth-child(n + 4) { display: none; }
  }
  @media (max-width: 640px) {
    .stmt { font-size: clamp(2.25rem, 11.4vw, 3.4rem); }
    .by { flex-wrap: wrap; }
    .hero { min-height: min(100svh, 760px); }
  }
  @media (prefers-reduced-motion: reduce) { .hero, .nav, .menu { transition: none !important; animation: none !important; } .trk { animation: none; } .pv figure { transition: none; } }
</style>

<script>
  // prévia do trabalho ao passar o mouse (ou focar) em uma palavra da frase
  const words = [...document.querySelectorAll<HTMLElement>('.stmt a.wd')];
  const pvs = [...document.querySelectorAll<HTMLElement>('.pv figure')];
  const show = (i: number | null) => { words.forEach((w) => w.classList.toggle('on', +w.dataset.w! === i)); pvs.forEach((f) => f.classList.toggle('on', +f.dataset.pv! === i)); };
  words.forEach((w) => { const i = +w.dataset.w!; w.addEventListener('pointerenter', () => show(i)); w.addEventListener('pointerleave', () => show(null)); w.addEventListener('focus', () => show(i)); w.addEventListener('blur', () => show(null)); });

  // navegação: no tom do hero enquanto está no topo, no papel depois
  const q = <T extends Element = HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const nav = q('[data-nav]'), hero = q('[data-hero]');
  new IntersectionObserver(([en]) => { nav.classList.toggle('on-color', en.isIntersecting); }, { rootMargin: '-64px 0px 0px 0px' }).observe(hero);
  addEventListener('scroll', () => nav.classList.toggle('stuck', scrollY > 24), { passive: true });
  nav.classList.toggle('stuck', scrollY > 24);
  // seção ativa: a última cujo topo já passou da linha de leitura (40% da tela)
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-links] a')];
  const secs = links.map((l) => document.querySelector<HTMLElement>(l.hash));
  let lock = 0, tick = 0;
  const mark = (id: string | null) => links.forEach((l) => l.setAttribute('aria-current', String(l.hash === '#' + id)));
  const update = () => {
    tick = 0; if (performance.now() < lock) return;
    const line = scrollY + innerHeight * 0.4; let id: string | null = null;
    secs.forEach((el) => { if (el && el.getBoundingClientRect().top + scrollY <= line) id = el.id; });
    if (innerHeight + scrollY >= document.documentElement.scrollHeight - 4) id = 'contato';
    mark(id);
  };
  addEventListener('scroll', () => { if (!tick) tick = requestAnimationFrame(update); }, { passive: true });
  addEventListener('resize', update);
  document.querySelectorAll<HTMLAnchorElement>('[data-links] a, [data-menu] a').forEach((a) => a.addEventListener('click', () => { if (a.hash) { mark(a.hash.slice(1)); lock = performance.now() + 1000; setTimeout(update, 1050); } }));
  update();
  const burger = q('[data-burger]'), menu = q('[data-menu]');
  const toggleMenu = (open: boolean) => { burger.setAttribute('aria-expanded', String(open)); burger.setAttribute('aria-label', open ? burger.dataset.close! : burger.dataset.open!); menu.hidden = !open; };
  burger.addEventListener('click', () => toggleMenu(menu.hidden));
  menu.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) toggleMenu(false); });
  addEventListener('keydown', (e) => { if (e.key === 'Escape') toggleMenu(false); });
</script>
