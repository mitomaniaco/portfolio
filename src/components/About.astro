---
import ChapterBar from './ChapterBar.astro';
import ToolMark from './ToolMark.astro';
import { Image } from 'astro:assets';
import caio from '../assets/img/caio.jpg';
import { ui, cvFile, type Lang } from '../i18n/ui';

const { lang = 'pt' } = Astro.props as { lang?: Lang };
const t = ui[lang].sec.about;

const jobMeta = [
  { y: '2025', now: true, tools: ['Figma', 'TypeScript', 'React', 'Astro', 'PostgreSQL', 'Claude'] },
  { y: '2024', now: false, tools: ['Premiere', 'After Effects', 'CapCut', 'Photoshop'] },
];
const jobs = t.jobs.map((j, i) => ({ ...j, ...jobMeta[i], rows: j.rows.map((r) => ('v' in r ? r : { ...r, tools: jobMeta[i].tools })) }));
const icons: Record<string, string> = {
  design: '<path d="M12 3a9 9 0 1 0 0 18c1.1 0 1.6-.9 1.2-1.8-.5-1-.1-2.2 1.1-2.2H17a4 4 0 0 0 4-4c0-5.5-4-10-9-10Z"/><circle cx="7.5" cy="11" r="1"/><circle cx="10.5" cy="7" r="1"/><circle cx="15" cy="7.5" r="1"/>',
  video: '<rect x="3" y="6" width="13" height="12" rx="2"/><path d="m16 10 5-3v10l-5-3"/>',
  code: '<path d="m8 8-4 4 4 4M16 8l4 4-4 4M13.5 5l-3 14"/>',
  db: '<ellipse cx="12" cy="6" rx="7" ry="3"/><path d="M5 6v6c0 1.7 3.1 3 7 3s7-1.3 7-3V6M5 12v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6"/>',
  ia: '<path d="M12 3v3M12 18v3M3 12h3M18 12h3M6.5 6.5l2 2M15.5 15.5l2 2M17.5 6.5l-2 2M8.5 15.5l-2 2"/><circle cx="12" cy="12" r="2.5"/>',
  check: '<path d="m5 12 4.5 4.5L19 7"/><rect x="3" y="3" width="18" height="18" rx="4"/>',
};
const skillMeta = [
  { i: 'design', col: '#c98a14', t: ['Figma', 'Photoshop', 'Illustrator'] },
  { i: 'video', col: '#e0613b', t: ['Premiere', 'After Effects', 'CapCut'] },
  { i: 'code', col: '#2f86d6', t: ['TypeScript', 'React', 'Astro', 'Node.js'] },
  { i: 'db', col: '#1fae5b', t: ['PostgreSQL', 'SQL', 'REST'] },
  { i: 'ia', col: '#8a5cd6', t: ['ChatGPT', 'Claude', 'Gemini'] },
  { i: 'check', col: '#111110', t: ['Git', 'GitHub'] },
];
const skills = t.skills.map((s, i) => ({ ...s, ...skillMeta[i] }));
---
<section class="sec alt" id="sobre" aria-labelledby="h-sobre">
  <div class="wrap">
    <ChapterBar n="04" tag={t.tag} meta={t.meta} />
    <div class="intro">
      <Image class="ph" src={caio} alt={t.alt} width={900} height={1613} widths={[480, 900]} sizes="(max-width: 760px) 80vw, 300px" fit="cover" position="top" format="webp" quality={84} loading="eager" />
      <div class="txt">
        <h2 class="big" id="h-sobre">{t.title}</h2>
        <div class="bio">{t.bio.map((p) => <p>{p}</p>)}</div>
        <dl class="info">{t.info.map((x) => <div><dt>{x.k}</dt><dd>{x.v}</dd></div>)}</dl>
        <div class="open">
          <p class="st"><i aria-hidden="true"></i>{t.status}</p>
          <a class="pill ink" href={cvFile[lang]} download>{ui[lang].nav.cvFull} <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 3v10M5.5 8.5 10 13l4.5-4.5M4 17h12" /></svg></a>
        </div>
      </div>
    </div>

    <div class="rows">
      <section class="row" aria-labelledby="r-exp">
        <header><h3 id="r-exp">{t.exp}</h3><p>{t.expMeta[0]}<br />{t.expMeta[1]}<br />{t.expMeta[2]}</p></header>
        <ol class="jobs">
          {jobs.map((j) => (
            <li class:list={{ now: j.now }}>
              <p class="yr tn" aria-hidden="true">{j.y}</p>
              <div class="jb">
                <p class="when tn">{j.when}{j.now && <em>{t.latest}</em>}</p>
                <h4>{j.role}</h4>
                <p class="org">{j.org}</p>
                <p class="sum">{j.sum}</p>
                <dl class="jd">
                  {j.rows.map((r) => (
                    <div>
                      <dt>{r.k}</dt>
                      <dd>
                        {'v' in r && r.v && <ul>{r.v.map((x) => <li>{x}</li>)}</ul>}
                        {'tools' in r && r.tools && <p class="jt">{r.tools.map((n) => <ToolMark name={n} />)}</p>}
                      </dd>
                    </div>
                  ))}
                </dl>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section class="row" aria-labelledby="r-kit">
        <header><h3 id="r-kit">{t.kit}</h3><p>{t.kitMeta}</p></header>
        <dl class="skills">
          {skills.map((x) => (
            <div style={`--k: ${x.col}`}>
              <dt><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons[x.i]} />{x.k}</dt>
              <dd>{x.c}</dd>
              <dd class="tools">{x.t.map((n) => <ToolMark name={n} />)}</dd>
            </div>
          ))}
        </dl>
      </section>
    </div>
  </div>
</section>

<style>
  .intro { display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: clamp(28px, 4.5vw, 72px); align-items: stretch; margin-top: clamp(32px, 4vw, 56px); }
  .ph { width: 100%; height: 100%; min-height: 360px; object-fit: cover; object-position: top; border-radius: 20px; background: #c4c4c5; }
  .txt { display: grid; gap: clamp(18px, 2vw, 26px); align-content: space-between; }
  .big { font-size: clamp(1.75rem, 1.2rem + 2.2vw, 3.25rem); line-height: 1.08; font-weight: 600; letter-spacing: -0.04em; text-wrap: balance; max-width: 22ch; }
  .bio { display: grid; gap: 14px; max-width: 60ch; color: var(--ink-2); font-size: var(--t-m); line-height: 1.6; text-wrap: pretty; }
  .info { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 clamp(16px, 2.4vw, 32px); border-top: 1px solid var(--rule); padding-top: 16px; }
  .info > div { display: grid; gap: 4px; align-content: start; }
  .info dt { font-size: var(--t-xs); font-weight: 700; color: var(--ink-3); }
  .info dd { font-size: var(--t-s); line-height: 1.45; text-wrap: pretty; }
  .open { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; }
  .open .st { display: inline-flex; align-items: center; gap: 10px; font-weight: 600; font-size: var(--t-s); }
  .open .st i { width: 9px; height: 9px; border-radius: 50%; background: #1fae5b; box-shadow: 0 0 0 4px rgb(31 174 91 / 0.22); }
  @media (max-width: 860px) {
    .intro { grid-template-columns: minmax(0, 1fr); }
    .ph { max-width: 300px; height: auto; aspect-ratio: 1536 / 2752; min-height: 0; }
    .info { grid-template-columns: minmax(0, 1fr); gap: 14px; }
  }

  .rows { margin-top: clamp(40px, 5vw, 72px); }
  .row { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 9fr); gap: 20px clamp(24px, 4vw, 64px); padding-block: clamp(24px, 2.6vw, 36px); border-top: 1px solid var(--rule); }
  .row:first-child { border-top: 1px solid var(--rule); }
  .row > header { align-self: start; position: sticky; top: 88px; }
  .row h3 { font-size: var(--t-l); font-weight: 700; letter-spacing: -0.01em; }
  .row header p { margin-top: 6px; font-size: var(--t-xs); color: var(--ink-3); line-height: 1.5; max-width: 22ch; }
  @media (max-width: 860px) { .row { grid-template-columns: minmax(0, 1fr); } .row > header { position: static; } }

  .jobs > li { position: relative; display: grid; grid-template-columns: 7rem minmax(0, 1fr); gap: 0 24px; padding-bottom: 36px; }
  .jobs > li:last-child { padding-bottom: 0; }
  .yr { font-size: clamp(1.75rem, 1.3rem + 1.2vw, 2.5rem); font-weight: 600; letter-spacing: -0.04em; line-height: 0.9; color: var(--rule); transition: color 200ms ease; }
  .jobs > li.now .yr { color: var(--ink); }
  .jb { position: relative; display: grid; gap: 2px; padding-left: 28px; border-left: 2px solid var(--rule); padding-bottom: 4px; }
  .jobs > li:last-child .jb { border-left-color: transparent; }
  .jb::before { content: ''; position: absolute; left: -7px; top: 3px; width: 12px; height: 12px; border-radius: 50%; background: var(--paper); box-shadow: inset 0 0 0 2.5px var(--ink-3); }
  .jobs > li.now .jb::before { background: var(--maxima); box-shadow: 0 0 0 4px rgb(19 33 59 / 0.14); }
  .when { display: flex; gap: 10px; align-items: center; font-size: var(--t-xs); font-weight: 700; color: var(--ink-3); }
  .when em { font-style: normal; padding: 2px 9px; border-radius: 999px; background: var(--ink); color: var(--paper); font-weight: 600; }
  h4 { font-size: 1.375rem; font-weight: 700; letter-spacing: -0.015em; line-height: 1.25; margin-top: 8px; }
  .org { color: var(--ink-3); font-size: var(--t-s); }
  .sum { margin-top: 12px; color: var(--ink); font-size: var(--t-m); line-height: 1.5; max-width: 60ch; text-wrap: pretty; }
  .jd { margin-top: 18px; border-top: 1px solid var(--rule); max-width: 66ch; }
  .jd > div { display: grid; grid-template-columns: 8.5rem minmax(0, 1fr); gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--rule); }
  .jd dt { font-size: var(--t-xs); font-weight: 700; color: var(--ink-3); padding-top: 3px; letter-spacing: 0.01em; }
  .jd ul { display: grid; gap: 6px; margin: 0; }
  .jd li { position: relative; padding-left: 16px; color: var(--ink-2); font-size: var(--t-s); line-height: 1.5; text-wrap: pretty; }
  .jd li::before { content: ''; position: absolute; left: 0; top: 0.62em; width: 6px; height: 6px; border-radius: 50%; background: var(--ink-3); }
  .jobs > li.now .jd li::before { background: var(--maxima); }
  .jt { display: flex; flex-wrap: wrap; gap: 8px 18px; font-size: var(--t-s); font-weight: 600; }
  @media (max-width: 560px) { .jobs > li { grid-template-columns: minmax(0, 1fr); } .yr { display: none; } .jb { padding-left: 20px; } .jd > div { grid-template-columns: minmax(0, 1fr); gap: 6px; } }

  .skills { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 clamp(24px, 4vw, 56px); }
  .skills > div { display: grid; gap: 6px; align-content: start; padding: 0 0 22px; margin-bottom: 22px; border-bottom: 1px solid var(--rule); }
  .skills > div:nth-last-child(-n+2) { border-bottom: 0; margin-bottom: 0; padding-bottom: 0; }
  .skills dt { display: flex; align-items: center; gap: 12px; font-weight: 700; font-size: var(--t-l); letter-spacing: -0.01em; }
  .skills dt svg { width: 26px; height: 26px; color: var(--k); stroke-width: 1.7; }
  .skills dd { color: var(--ink-2); font-size: var(--t-s); line-height: 1.5; text-wrap: pretty; }
  .skills dd:not(.tools) { padding-left: 38px; }
  .skills .tools { display: flex; flex-wrap: wrap; gap: 8px 18px; margin: 10px 0 0 38px; color: var(--ink); font-weight: 600; font-size: var(--t-s); }
  @media (max-width: 700px) {
    .skills { grid-template-columns: minmax(0, 1fr); }
    .skills > div:nth-last-child(-n+2) { border-bottom: 1px solid var(--rule); margin-bottom: 22px; padding-bottom: 22px; }
    .skills > div:last-child { border-bottom: 0; margin-bottom: 0; padding-bottom: 0; }
  }
</style>
